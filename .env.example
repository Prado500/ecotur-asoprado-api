# ==========================================
# Configuration template for postgresql db
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=DIGITAR_CONTRASEÑA_PRIVADA
POSTGRES_DB=NOMBRE_DB_EN_LOCAL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==========================================
# Async URL connection string (for SQLAlchemy)
# ==========================================

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ==========================================
# Security and JWTs  (JSON Web Tokens)
# ==========================================
JWT_SECRET_KEY=ecotur_secreto_super_seguro_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
VERIFICATION_TOKEN_EXPIRE_MINUTES=15

# ==========================================
# Email (SMTP account that sends the verification email)
# ==========================================
MAIL_USERNAME=cuenta_smtp@example.com
MAIL_PASSWORD=DIGITAR_CONTRASEÑA_DE_APLICACION
# Optional: when missing, the sender is MAIL_USERNAME.
MAIL_FROM=cuenta_smtp@example.com
MAIL_PORT=465
MAIL_SERVER=smtp.gmail.com

# ==========================================
# Cloud Storage (Azure Blob Storage)
# ==========================================
AZURE_STORAGE_CONNECTION_STRING=Endpoint=sb://...
AZURE_CONTAINER_NAME=ecotur-images
AZURE_TEMPORAL_CONTAINER_NAME=temp-ecotur-images

# ==========================================
# Frontend (base URL of the links sent by email)
# ==========================================
FRONTEND_URL=http://localhost:3000

# ==========================================
# CORS (browser clients only; mobile and Postman send no Origin)
# ==========================================
# Comma-separated list of exact origins (scheme://host[:port], no path, no trailing slash).
# Wildcards are rejected at startup. Each deployment sets only its own frontend here.
CORS_ORIGINS=http://localhost:3000
